#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
export UV_PYTHON=python3.12

if [ -x ".git/hooks/pre-commit.local" ]; then
    .git/hooks/pre-commit.local || exit 1
fi

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#staged_files[@]}" -eq 0 ]; then
    exit 0
fi

python_files=()
c_files=()

for file in "${staged_files[@]}"; do
    case "$file" in
        *.py)
            python_files+=("$file")
            ;;
        *.c|*.h)
            c_files+=("$file")
            ;;
    esac
done

if [ "${#python_files[@]}" -gt 0 ]; then
    echo "[pre-commit] Ruff lint on staged Python files..."
    uv run ruff check --fix "${python_files[@]}"
    echo "[pre-commit] YAPF format on staged Python files..."
    uv run yapf --in-place "${python_files[@]}"
    git add -- "${python_files[@]}"
fi

if [ "${#c_files[@]}" -gt 0 ]; then
    echo "[pre-commit] clang-format on staged C files..."
    # Use `uv run` to match ruff/yapf above — clang-format is pinned in
    # pyproject.toml's dev group, so `uv sync` gives every contributor the
    # same version without requiring apt/brew/uv-tool installs.
    uv run clang-format -i "${c_files[@]}"
    git add -- "${c_files[@]}"
fi
