#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
export UV_PYTHON=python3.12

if [ -x ".git/hooks/pre-commit.local" ]; then
    .git/hooks/pre-commit.local || exit 1
fi

# TWO lists, deliberately.
#
# staged_files is ACMR-filtered because ruff and yapf are handed paths and both
# exit 1 on a path that no longer exists -- under `set -e` that would make every
# deletion commit fail at the lint step.
#
# staged_all is unfiltered because the pyrefly gate must run on commits that
# ONLY delete, and on commits that touch no .py at all. A pure `git rm` of a
# module its dependents still import is exactly the change a type gate exists to
# catch, and the ACMR filter makes it invisible.
mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)
mapfile -t staged_all   < <(git diff --cached --name-only)

# Exit early only when there is NOTHING staged at all. Keying this off the
# filtered list would exit 0 on a deletion-only commit before any gate ran.
if [ "${#staged_all[@]}" -eq 0 ]; then
    exit 0
fi

python_files=()
c_files=()

for file in "${staged_files[@]}"; do
    case "$file" in
        *.py)
            python_files+=("$file")
            ;;
        *.c|*.h)
            c_files+=("$file")
            ;;
    esac
done

if [ "${#python_files[@]}" -gt 0 ]; then
    # Every uv call in both hooks is `uv run --no-sync`: from a worktree that borrows
    # main's .venv, a syncing `uv run` re-points the shared editable install at the
    # worktree and can rebuild main's binding .so in place (#220).
    echo "[pre-commit] Ruff lint on staged Python files..."
    uv run --no-sync ruff check --fix "${python_files[@]}"
    echo "[pre-commit] YAPF format on staged Python files..."
    uv run --no-sync yapf --in-place "${python_files[@]}"
    git add -- "${python_files[@]}"

    # Deferred complexity gates (threshold 40): uncomment once the existing
    # maintainability backlog is small enough for these checks to block commits.
    # echo "[pre-commit] Ruff McCabe complexity on staged Python files..."
    # uv run --no-sync ruff check --select C901 \
    #     --config 'lint.mccabe.max-complexity=40' "${python_files[@]}"
    # echo "[pre-commit] Cognitive complexity on staged Python files..."
    # uv run --no-sync complexipy "${python_files[@]}" --failed --plain
fi

if [ "${#c_files[@]}" -gt 0 ]; then
    echo "[pre-commit] clang-format on staged C files..."
    # Use `uv run` to match ruff/yapf above — clang-format is pinned in
    # pyproject.toml's dev group, so `uv sync` gives every contributor the
    # same version without requiring apt/brew/uv-tool installs.
    uv run --no-sync clang-format -i "${c_files[@]}"
    git add -- "${c_files[@]}"
fi

# ---------------------------------------------------------------------------
# pyrefly type gate. Its own block, computed from the UNFILTERED list.
#
# Placement after the `git add` calls above is load-bearing: ruff --fix and yapf
# --in-place rewrite whole files and force-add them, so the index after those
# steps is not the index the user staged. Running the gate last makes "exactly
# what is about to be committed" more true, not less.
#
# Why each non-.py path triggers it -- these are the commits that can DISABLE the
# gate, and a *.py-only trigger never invokes it for any of them:
#   pyrefly.toml           narrowing project-includes hides files from the gate
#   pyrefly-snapshot.json  rewriting the freeze must be checked against the freeze
#   pyproject.toml/uv.lock the frozen count depends on installed site-packages,
#                          so the person who bumps the lock gets the red, rather
#                          than whoever next commits a .py -- provided they have
#                          run `uv sync`: the hook's --no-sync never syncs for them,
#                          so it prints a NOTE saying so (below) and does not block
#   scripts/pyrefly_gate.py, .githooks/pre-commit
#                          editing the gate or its wiring should run the gate
#
# TWO LIMITS, both real and neither fixable here:
#  1. `git commit --no-verify` skips all of this, and nothing detects it
#     afterwards. There is no CI; these hooks are the only enforcement point.
#  2. This runs the WORKING-TREE copy of scripts/pyrefly_gate.py, so a commit
#     that neuters the gate is checked by the neutered gate. Listing the script
#     in the trigger above makes that case look covered; it is not. Same class as
#     --no-verify, and equally unfixable by a hook.
# Also: rebase, revert and cherry-pick run no hook at all -- not this one and not
# pre-merge-commit. Verified by installing a logging hook under both names.
# ---------------------------------------------------------------------------
pyrefly_trigger=0
for file in "${staged_all[@]}"; do
    case "$file" in
        *.py|pyrefly.toml|pyrefly-snapshot.json|pyproject.toml|uv.lock|\
        scripts/pyrefly_gate.py|.githooks/pre-commit)
            pyrefly_trigger=1
            ;;
    esac
done

if [ "$pyrefly_trigger" -eq 1 ]; then
    # A dependency change is checked against the .venv as it is NOW (#220: no hook
    # syncs). Advisory only; keep the echo a plain double-quoted literal with no
    # `$` or backtick, or tests/integration/test_pyrefly_hook.py reads its `uv sync` as a call.
    for file in "${staged_all[@]}"; do
        case "$file" in
            pyproject.toml|uv.lock)
                echo "[pre-commit] NOTE: pyproject.toml/uv.lock staged and the hooks never sync (#220): run 'uv sync' in the main checkout first, or the gate below checks the old .venv."
                break
                ;;
        esac
    done
    echo "[pre-commit] pyrefly type check (index, whole project)..."
    uv run --no-sync python scripts/pyrefly_gate.py
fi
