.{
    // Package name used as the key when other packages depend on this one.
    // Must be an identifier in Zig 0.14 (not a quoted string).
    .name = .cs2rl_c_env,

    .version = "0.1.0",

    // Fingerprint is generated by `zig init` and must never change for a given
    // package identity — changing it breaks trust / deduplication.
    .fingerprint = 0xa14b14c63e04faac, // Changing this has security and trust implications.

    // Earliest Zig version that is a supported use case for this package.
    .minimum_zig_version = "0.14.0",

    // Dependencies: url+hash generated by `zig fetch --save`. Do NOT hand-edit the hash.
    .dependencies = .{
        .raylib = .{
            .url = "https://github.com/raysan5/raylib/archive/75b6b825dfc93488bc411c00845164b5c0f8fae6.zip",
            .hash = "raylib-5.5.0-AAAAAHV3zADPmK0F1nLRNCUQrnezXuXiIs3ixRNKFHdN",
        },
    },

    // File list for publishing. This package is a leaf (not consumed as a Zig
    // dependency by other packages), so .paths only needs to satisfy `zig build`.
    // cs2_demo.c headers (cs2_env.h, nav_data.h, etc.) are not listed because
    // this package is never published or depended on externally.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "binding.c",
        "cs2_types.h",
        "cs2_demo.c",
    },
}
