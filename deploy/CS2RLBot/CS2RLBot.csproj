<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>CS2RLBot</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.364" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <!-- Ray-Trace LOS raycasting — DLL-only, no NuGet package.
       Source: https://github.com/FUNPLAY-pro-CS2/Ray-Trace/releases/tag/v1.0.7
       We reference the API stub (RayTraceApi.dll) from the shared/ folder of the
       CSS-API release archive. The actual implementation lives in two server-side
       pieces: RayTraceImpl (CSS plugin) and RayTrace.so (Metamod plugin).
       Private=false: CounterStrikeSharp resolves RayTraceApi via its own shared
       assembly loader at runtime (counterstrikesharp/shared/RayTraceApi/).
       Setting Private=false prevents MSBuild from copying RayTraceApi.dll into
       our plugin output folder, which would shadow the shared copy and break
       cross-plugin type identity. -->
  <ItemGroup>
    <Reference Include="RayTraceApi">
      <HintPath>libs/RayTraceApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
