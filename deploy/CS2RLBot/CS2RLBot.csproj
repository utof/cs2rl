<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>CS2RLBot</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.364" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <!-- Ray-Trace LOS raycasting — DLL-only, no NuGet package.
       Source: https://github.com/FUNPLAY-pro-CS2/Ray-Trace/releases/tag/v1.0.7
       This reference is the compile-time API stub (RayTraceApi.dll from the CSS-API
       release archive's shared/ folder). The actual implementation lives in two
       server-side pieces: RayTraceImpl (CounterStrikeSharp plugin) + RayTrace.so (Metamod plugin).
       Private=false: CSS loads the runtime assembly from
       addons/counterstrikesharp/shared/RayTraceApi.dll via its shared loader.
       Copying a second RayTraceApi.dll next to our plugin would shadow that shared
       copy and break cross-plugin type identity — Private=false prevents that. -->
  <ItemGroup>
    <Reference Include="RayTraceApi">
      <HintPath>libs/RayTraceApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
