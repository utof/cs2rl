# Copy to .env and fill in your values.
# W&B picks these up automatically when --wandb is passed.

# Required for W&B (alternative to running `wandb login`)
# WANDB_API_KEY=your_key_here

# Optional: defaults to your logged-in account
# WANDB_ENTITY=your_username_or_team

# Optional: defaults to "cs2rl"
# WANDB_PROJECT=cs2rl
